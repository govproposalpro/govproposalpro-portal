# --- Server ---
PORT=3000
NODE_ENV=production
# Set to the number of proxies in front of the app (1 for Render/Heroku/Nginx) so rate limiting sees real client IPs.
TRUST_PROXY=1

# Origins allowed to call /api/register from another domain (your GoHighLevel funnel page).
# Comma-separated, exact scheme + host, no trailing slash.
ALLOWED_ORIGINS=https://access.yourdomain.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:password@host:5432/govproposalpro
# Set to "true" when your host requires TLS (most managed Postgres does).
DATABASE_SSL=true

# --- Purchase gate ---
# When true (recommended), only emails in authorized_purchasers can register.
REQUIRE_PURCHASE=true
# Signing secret from your Whop webhook settings (starts with whsec_). Leave blank to disable the webhook route.
WHOP_WEBHOOK_SECRET=

# --- Security ---
BCRYPT_ROUNDS=12

# --- Email: choose "smtp" (Nodemailer) or "ghl" (GoHighLevel inbound webhook) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GovProposalPro <access@govproposalpro.com>"
EMAIL_REPLY_TO=support@govproposalpro.com

# Only used when EMAIL_PROVIDER=ghl: the Inbound Webhook URL from a GoHighLevel workflow.
GHL_WEBHOOK_URL=

# --- Command Center (dashboard at /app) ---
# Claude API key for the AI Proposal Engine and AI Bid Decryptor.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=
# Members can sign in from this moment (ISO 8601). Leave blank to allow sign-in now.
APP_LAUNCH_AT=2026-10-18T13:00:00Z
# Comma-separated emails that may sign in before APP_LAUNCH_AT (the team, for testing).
APP_EARLY_ACCESS_EMAILS=
# Bid Decryptor runs allowed per member per 24 hours (cost guard).
DECRYPTS_PER_DAY=25
# Company document uploads per member per day, and total Claude calls per day for the whole site.
DOCS_PER_DAY=15
AI_DAILY_CALL_CAP=300
# SAM.gov public API key for Sub-Safe vetting. Free from sam.gov > Account Details. Without a
# federal role a key gets 10 calls a day; request a role for 1,000.
SAM_API_KEY=
# Optional, Enterprise only: Google Places API (New) key for top-rated local subcontractors with
# phone and website. Results are not stored. Each member gets PLACES_SEARCHES_PER_DAY searches a day.
GOOGLE_PLACES_API_KEY=
PLACES_SEARCHES_PER_DAY=15

# --- Landing page buy buttons: optional overrides of the built-in Whop links (https only) ---
WHOP_CORE_ACCESS_URL=
WHOP_ENTERPRISE_ACCESS_URL=
SITE_CTA_URL=
WHOP_CORE_CHECKOUT_URL=
WHOP_ENTERPRISE_CHECKOUT_URL=
# Terms and Privacy pages (/terms, /privacy). Defaults: Valor Innovation Management & Consulting (dba GovProposal Pro), Ohio, contact@govproposalpro.com.
LEGAL_ENTITY=
LEGAL_STATE=
SUPPORT_EMAIL=
# Base URL used in password reset and admin setup links.
APP_BASE_URL=https://access.govproposalpro.com

# --- Admin dashboard (at /admin) ---
# Created on every deploy if missing (never changed once they exist). Owners get a setup link by
# email; VAs get theirs from an owner in Admin > Team.
ADMIN_OWNER_EMAILS=jalen@contractbros.com,kinno@contractbros.com
ADMIN_VA_EMAILS=va1@govproposalpro.com,va2@govproposalpro.com,va3@govproposalpro.com,va4@govproposalpro.com,va5@govproposalpro.com
